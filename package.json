{
  "name": "flowctrl",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@9.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "npm run --prefix apps/backend test:integration",
    "prettier:check": "prettier --check \"apps/**/*.{js,jsx}\" \"packages/**/*.{js,jsx}\"",
    "format": "prettier --write \"**/*.{js,jsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  }
}
