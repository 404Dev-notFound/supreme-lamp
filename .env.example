# ==========================================
# FlowCTRL Production Environment Example
# ==========================================

# PostgreSQL & Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=flowCTRL
# Internal Docker: postgresql://postgres:password@postgres:5432/flowCTRL
# Local Dev: postgresql://postgres:password@localhost:5432/flowCTRL
DATABASE_URL="postgresql://postgres:replace-with-strong-db-password@localhost:5432/flowCTRL"

# Redis & Distributed Rate Limiting (Optional - falls back to memory if unset)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Session Security
JWT_SECRET=replace-with-minimum-32-char-random-secret
JWT_REFRESH_SECRET=replace-with-minimum-32-char-refresh-secret
NEXTAUTH_SECRET=replace-with-minimum-32-char-random-secret
NEXTAUTH_URL=http://localhost:3000

# Cookie Security Settings (set COOKIE_SECURE=true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Service URLs & Ports
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_BACKEND_URL=http://backend:5000

# Internal AI Microservices
RESUME_SCREENER_URL=http://127.0.0.1:5001
MENTAL_HEALTH_SERVICE_URL=http://127.0.0.1:8000
GROQ_API_KEY=replace-with-groq-api-key

# Node Environment
NODE_ENV=production

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
