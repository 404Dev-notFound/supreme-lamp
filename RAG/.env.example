# ==============================================================================
# flowCTRL RAG Engine Configuration Template
# Copy this file to .env and configure provider credentials as required.
# ==============================================================================

# Server & Network Configuration
RAG_HOST=127.0.0.1
RAG_PORT=8001
NODE_ENV=development

# LLM Provider Configuration: 'local' (deterministic grounded) | 'openai' | 'gemini' | 'groq'
RAG_LLM_PROVIDER=local

# Embedding Provider Configuration (Decoupled from LLM): 'minilm' (default, 384 dims) | 'openai' (1536 dims) | 'gemini' (768 dims)
RAG_EMBEDDING_PROVIDER=minilm
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384
RAG_EMBEDDING_VERSION=v2
EMBEDDING_MODEL_PATH=

# Vector Database (Qdrant) Configuration
# Leave QDRANT_URL empty to use persistent local disk storage in QDRANT_STORAGE_PATH
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_URL=
QDRANT_API_KEY=
RAG_COLLECTION_NAME=flowctrl_kb_v2

# Retrieval & Chunking Parameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_TOKENS=3500

# Security & Administrative Authorization
# In production, RAG_ADMIN_SECRET must be configured with at least 16 characters.
RAG_ADMIN_SECRET=
RAG_REQUEST_TIMEOUT_SECONDS=15
RAG_ALLOW_PROMPT_OVERRIDE=false

# OpenAI Configuration (optional if using external LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (optional if using external LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Groq Configuration (optional if using external LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Redis Cache Integration (optional, in-memory resilient fallback is active)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=fc:rag:
RAG_CACHE_TTL=1800
