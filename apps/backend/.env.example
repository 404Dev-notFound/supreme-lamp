# ==========================================
# FlowCTRL Backend Environment Example
# ==========================================

PORT=5000
NODE_ENV=production

# Database Connection
DATABASE_URL="postgresql://postgres:replace-with-strong-db-password@localhost:5432/flowCTRL"

# Redis & Distributed Rate Limiting (Optional)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Session Secrets
JWT_SECRET=replace-with-minimum-32-char-random-secret
JWT_REFRESH_SECRET=replace-with-minimum-32-char-refresh-secret
NEXTAUTH_SECRET=replace-with-minimum-32-char-random-secret

# CORS & Cookie Security
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Internal Microservices
RESUME_SCREENER_URL=http://127.0.0.1:5001
MENTAL_HEALTH_SERVICE_URL=http://127.0.0.1:8000
