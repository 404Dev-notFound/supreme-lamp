{
  "openapi": "3.0.3",
  "info": {
    "title": "flowCTRL (supreme-lamp) API",
    "version": "1.0.0",
    "description": "Production Career Intelligence and Opportunity Management Platform API."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "flowctrl_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "System Health Status",
        "responses": {
          "200": { "description": "System operational" }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness Probe",
        "responses": {
          "200": { "description": "All dependencies connected" },
          "503": { "description": "Dependencies unavailable" }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Register a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Account already exists" }
        }
      }
    },
    "/api/auth/signin": {
      "post": {
        "summary": "Authenticate user credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Retrieve current session context",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User context returned" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Request password reset link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Instructions generated" }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Reset password using token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "newPassword"],
                "properties": {
                  "token": { "type": "string" },
                  "newPassword": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset successfully" },
          "400": { "description": "Invalid or expired token" }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "Browse active job listings with search & filters",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "workMode", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of jobs returned" }
        }
      },
      "post": {
        "summary": "Create job listing",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Job created" },
          "403": { "description": "Recruiter/Admin required" }
        }
      }
    },
    "/api/mentors": {
      "get": {
        "summary": "Browse mentor directory",
        "responses": {
          "200": { "description": "Mentors listed" }
        }
      }
    },
    "/api/resumes/upload": {
      "post": {
        "summary": "Upload PDF resume",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Resume stored" }
        }
      }
    },
    "/api/catalog/skills": {
      "get": {
        "summary": "List skills with search & category filter",
        "responses": {
          "200": { "description": "Skills listed" }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "summary": "List user notifications",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Notifications listed" }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "summary": "Get system platform stats",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Stats returned" },
          "403": { "description": "Admin access required" }
        }
      }
    },
    "/api/services/mental-health/predict": {
      "post": {
        "summary": "Predict student/professional mental health score",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Score returned" }
        }
      }
    }
  }
}
