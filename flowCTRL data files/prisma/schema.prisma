generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  USER
  MENTOR
  RECRUITER
  COMPANY_REP
  ADMIN
  SUPER_ADMIN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

// ==========================================
// 1. IDENTITY & AUTHENTICATION MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  
  // Legacy / Direct Profile Attributes (Preserved for backward compatibility)
  headline      String?
  bio           String?   @db.Text
  location      String?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relational User Account Architecture
  profile         UserProfile?
  preferences     UserPreference?
  userSessions    UserSession[]

  // NextAuth & Identity Relations
  accounts      Account[]
  sessions      Session[]
  securityLogs  SecurityLog[]

  // User-Owned Data Relations
  userSkills      UserSkill[]
  roadmaps        Roadmap[]
  mentorProfile   MentorProfile?
  resumes         Resume[]
  resumeAnalyses  ResumeAnalysis[]
  savedJobs       SavedJob[]
  jobApplications JobApplication[]

  // Project & Collaboration Relations
  ownedProjects   Project[]        @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  createdIssues   Issue[]          @relation("IssueCreator")
  assignedIssues  Issue[]          @relation("IssueAssignee")

  // Notifications & Progress
  notifications   Notification[]
  roadmapProgress UserRoadmapProgress[]
  auditLogs       AuditLog[]

  // Membership & Subscriptions
  membership             UserMembership?
  membershipHistory      MembershipHistory[]
  membershipTransactions MembershipTransaction[]

  // Project-Building Tutorials Relations
  projectProgress        UserProjectProgress[]
  projectBookmarks       ProjectBookmark[]

  // User Progress, Bookmarks & Analytics
  dsaProgress            UserDsaProgress[]
  resourceBookmarks      ResourceBookmark[]
  activityLogs           UserActivityLog[]
  analyticsEvents        PlatformAnalyticsEvent[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  userId      String   @id
  displayName String?
  firstName   String?
  lastName    String?
  headline    String?
  bio         String?  @db.Text
  avatarUrl   String?
  location    String?
  websiteUrl  String?
  githubUrl   String?
  linkedinUrl String?
  twitterUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  userId               String   @id
  theme                String   @default("dark") // dark, light, system
  emailNotifications   Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  jobAlerts            Boolean  @default(true)
  profileVisibility    String   @default("PUBLIC") // PUBLIC, PRIVATE, RECRUITERS_ONLY
  careerGoalVisibility Boolean  @default(true)
  customSettings       Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  deviceType   String?   @default("Desktop") // Desktop, Mobile, Tablet, Unknown
  browser      String?
  os           String?
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String
  eventType String   // login_success, failed_login, register_success, password_change, session_revoked, logout
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ==========================================
// 2. SKILLS & CATEGORIES (SHARED CATALOG & USER RELATIONS)
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills Skill[]
}

model CareerPath {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  description String?  @db.Text
  level       String   @default("Mid-Level") // Beginner, Mid-Level, Senior, Lead
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id          String      @id @default(cuid())
  name        String      @unique
  category    String
  categoryId  String?
  description String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryRef Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userSkills  UserSkill[]
  jobSkills   JobSkill[]

  @@index([category])
  @@index([categoryId])
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  proficiency Int      @default(3) // 1 to 5 scale
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ==========================================
// 3. ROADMAPS & LEARNING TRACKS
// ==========================================

model Roadmap {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  category    String         @default("role") // role, skill, best-practice
  slug        String?
  isPublic    Boolean        @default(false)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases RoadmapPhase[]

  @@index([userId])
  @@index([isPublic])
}

model RoadmapPhase {
  id          String        @id @default(cuid())
  title       String
  order       Int
  roadmapId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks   RoadmapTask[]

  @@index([roadmapId])
}

model RoadmapTask {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  completed      Boolean      @default(false)
  order          Int          @default(0)
  roadmapPhaseId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  phase RoadmapPhase @relation(fields: [roadmapPhaseId], references: [id], onDelete: Cascade)

  @@index([roadmapPhaseId])
}

// ==========================================
// 4. RESUMES & ATS ANALYSIS
// ==========================================

model Resume {
  id        String   @id @default(cuid())
  userId    String?
  fileName  String
  fileSize  Int
  fileUrl   String?
  storageKey String?
  mimeType  String   @default("application/pdf")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses        ResumeAnalysis[]
  jobApplications JobApplication[]

  @@index([userId])
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  resumeId        String?
  userId          String?
  overallScore    Int
  verdict         String
  verdictReason   String?  @db.Text
  atsScore        Int?
  atsIssues       Json?
  topFixes        Json?
  strengths       Json?
  flaws           Json?
  sectionFeedback Json?
  createdAt       DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([createdAt])
}

// ==========================================
// 5. COMPANIES, JOBS & APPLICATIONS
// ==========================================

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  logo        String?
  website     String?
  location    String?
  description String?  @db.Text
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]
}

model Job {
  id          String    @id @default(cuid())
  title       String
  companyId   String
  location    String
  workMode    WorkMode  @default(REMOTE)
  salaryMin   Int?
  salaryMax   Int?
  currency    String    @default("USD")
  description String?   @db.Text
  applyUrl    String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSkills    JobSkill[]
  savedJobs    SavedJob[]
  applications JobApplication[]

  @@index([companyId])
  @@index([workMode])
  @@index([location])
  @@index([isActive])
  @@index([createdAt])
}

model JobSkill {
  id         String   @id @default(cuid())
  jobId      String
  skillId    String
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model JobApplication {
  id        String            @id @default(cuid())
  userId    String
  jobId     String
  resumeId  String?
  status    ApplicationStatus @default(APPLIED)
  notes     String?           @db.Text
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobId])
  @@index([resumeId])
  @@index([status])
}

// ==========================================
// 6. MENTORSHIP
// ==========================================

model MentorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  expertise   String
  yearsOfExp  Int
  hourlyRate  Decimal? @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 7. PROJECTS, ISSUES & WORKSPACE COLLABORATION
// ==========================================

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("General")
  difficulty  String   @default("Intermediate")
  techStack   String[]
  image       String?
  description String?  @db.Text
  githubUrl   String?
  isPinned    Boolean  @default(false)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String?
  owner       User?    @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  issues      Issue[]

  @@index([ownerId])
  @@index([category])
  @@index([isPinned])
  @@index([createdAt])
}

model ProjectMember {
  projectId   String
  userId      String
  projectRole String   @default("viewer") // owner, admin, editor, viewer
  joinedAt    DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Issue {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  tags        String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  creatorId   String?
  creator     User?         @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

// ==========================================
// 8. NOTIFICATIONS & AUDITING
// ==========================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String    @db.Text
  type      String    @default("info") // info, success, warning, alert, project, job
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, read])
  @@index([createdAt])
}

model UserRoadmapProgress {
  id              String   @id @default(cuid())
  userId          String
  roadmapSlug     String
  completedTopics String[]
  currentTopic    String?
  progressPercent Int      @default(0)
  isCompleted     Boolean  @default(false)
  completedAt     DateTime?
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapSlug])
  @@index([userId])
  @@index([roadmapSlug])
  @@index([isCompleted])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

// ==========================================
// 9. MEMBERSHIP & PREMIUM LEARNING RESOURCES
// ==========================================

model MembershipPlan {
  id          String   @id @default(cuid())
  code        String   @unique // "FREE", "PREMIUM_MONTHLY", "PREMIUM_ANNUAL"
  name        String
  description String?  @db.Text
  tier        String   @default("PREMIUM") // "FREE" or "PREMIUM"
  price       Decimal  @default(0.00) @db.Decimal(10, 2)
  currency    String   @default("USD")
  interval    String?  // "month", "year", "lifetime", null
  features    String[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships UserMembership[]
  history     MembershipHistory[]

  @@index([code])
  @@index([tier])
  @@index([isActive])
}

model UserMembership {
  id             String    @id @default(cuid())
  userId         String    @unique
  planId         String
  tier           String    @default("FREE") // "FREE" or "PREMIUM"
  status         String    @default("ACTIVE") // "ACTIVE", "EXPIRED", "CANCELLED", "PAST_DUE"
  startDate      DateTime  @default(now())
  expiresAt      DateTime? // null = recurring/unlimited, otherwise expiration date
  autoRenew      Boolean   @default(false)
  cancelledAt    DateTime?
  lastVerifiedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         MembershipPlan          @relation(fields: [planId], references: [id])
  transactions MembershipTransaction[]

  @@index([userId])
  @@index([tier])
  @@index([status])
  @@index([expiresAt])
}

model MembershipHistory {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  action    String    // "ACTIVATED", "UPGRADED", "RENEWED", "EXPIRED", "CANCELLED"
  tier      String    @default("PREMIUM")
  startDate DateTime
  endDate   DateTime?
  note      String?   @db.Text
  createdAt DateTime  @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([createdAt])
}

model MembershipTransaction {
  id                String   @id @default(cuid())
  membershipId      String?
  userId            String
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD")
  status            String   // "PENDING", "COMPLETED", "FAILED", "REFUNDED"
  paymentMethod     String?  // "card", "mock", "crypto"
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  membership UserMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([membershipId])
  @@index([status])
  @@index([createdAt])
}

model ResourceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources PremiumResource[]

  @@index([slug])
}

model PremiumResource {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String   @db.Text
  categorySlug   String?
  categoryId     String?
  accessLevel    String   @default("PREMIUM") // "FREE" or "PREMIUM"
  level          String   @default("Advanced") // "Beginner", "Intermediate", "Advanced"
  badge          String?  @default("PREMIUM") // "PREMIUM", "PRO", "DEEP DIVE"
  iconName       String?  @default("Sparkles")
  estimatedHours Int?     @default(25)
  topicsCount    Int      @default(0)
  externalUrl    String?
  content        Json?    // modules, chapters, detailed curated resource guides
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isPinned       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookmarks ResourceBookmark[]

  @@index([slug])
  @@index([accessLevel])
  @@index([isActive])
  @@index([isPinned])
  @@index([categoryId])
  @@index([categorySlug])
}

// ==========================================
// 10. PROJECT-BUILDING TUTORIALS
// ==========================================

model ProjectTutorialCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  icon        String?  @default("FolderGit2")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutorials   ProjectTutorial[]

  @@index([slug])
}

model ProjectTutorial {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  description           String   @db.Text
  categorySlug          String
  categoryId            String?
  language              String
  languages             String[]
  difficulty            String   @default("Intermediate") // Beginner, Intermediate, Advanced
  estimatedHours        Int?     @default(15)
  whatYouWillBuild      String?  @db.Text
  whyBuildThis          String?  @db.Text
  realWorldApplications String?  @db.Text
  expectedOutcome       String?  @db.Text
  prerequisites         String[]
  technologies          String[]
  toolsRequired         String[]
  learningOutcomes      String[]
  projectType           String   @default("TUTORIAL") // TUTORIAL, PROJECT_IDEA, EXERCISE, IMPLEMENTATION_GUIDE
  tutorialUrl           String?
  githubUrl             String?
  sourceRepositories    String[] @default([])
  sourceRepo            String?  @default("https://github.com/codecrafters-io/build-your-own-x")
  sourceAuthor          String?
  sourceLicense         String?  @default("CC0-1.0")
  isPublished           Boolean  @default(true)
  isFeatured            Boolean  @default(false)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category              ProjectTutorialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  steps                 ProjectStep[]
  resources             ProjectResource[]
  userProgress          UserProjectProgress[]
  bookmarks             ProjectBookmark[]

  @@index([slug])
  @@index([categorySlug])
  @@index([language])
  @@index([difficulty])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([projectType])
}

model ProjectStep {
  id                String   @id @default(cuid())
  projectTutorialId String
  stepNumber        Int
  title             String
  objective         String?  @db.Text
  whyNecessary      String?  @db.Text
  content           String   @db.Text
  codeSnippet       String?  @db.Text
  codeLanguage      String?
  concepts          String[]
  referenceUrls     String[]
  expectedResult    String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           ProjectTutorial           @relation(fields: [projectTutorialId], references: [id], onDelete: Cascade)
  stepProgress      UserProjectStepProgress[]

  @@unique([projectTutorialId, stepNumber])
  @@index([projectTutorialId])
  @@index([stepNumber])
}

model ProjectResource {
  id                String   @id @default(cuid())
  projectTutorialId String
  title             String
  url               String
  resourceType      String   @default("ORIGINAL_TUTORIAL") // ORIGINAL_TUTORIAL, GITHUB_REPO, OFFICIAL_DOCS, SPECIFICATION, VIDEO, ARTICLE
  description       String?  @db.Text
  author            String?
  isVerified        Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           ProjectTutorial @relation(fields: [projectTutorialId], references: [id], onDelete: Cascade)

  @@index([projectTutorialId])
  @@index([resourceType])
}

model UserProjectProgress {
  id                 String    @id @default(cuid())
  userId             String
  projectTutorialId  String
  status             String    @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED
  currentStepNumber  Int       @default(1)
  completedStepCount Int       @default(0)
  totalStepCount     Int       @default(0)
  progressPercent    Int       @default(0)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  lastActivityAt     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            ProjectTutorial           @relation(fields: [projectTutorialId], references: [id], onDelete: Cascade)
  stepProgress       UserProjectStepProgress[]

  @@unique([userId, projectTutorialId])
  @@index([userId])
  @@index([projectTutorialId])
  @@index([status])
}

model UserProjectStepProgress {
  id             String    @id @default(cuid())
  userProgressId String
  projectStepId  String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userProgress   UserProjectProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  step           ProjectStep         @relation(fields: [projectStepId], references: [id], onDelete: Cascade)

  @@unique([userProgressId, projectStepId])
  @@index([userProgressId])
  @@index([projectStepId])
  @@index([isCompleted])
}

model ProjectBookmark {
  id                String   @id @default(cuid())
  userId            String
  projectTutorialId String
  createdAt         DateTime @default(now())

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           ProjectTutorial @relation(fields: [projectTutorialId], references: [id], onDelete: Cascade)

  @@unique([userId, projectTutorialId])
  @@index([userId])
  @@index([projectTutorialId])
}

// ==========================================
// 11. USER PROGRESS, BOOKMARKS & PLATFORM ANALYTICS
// ==========================================

model UserDsaProgress {
  id            String    @id @default(cuid())
  userId        String
  problemSlug   String
  language      String?
  isSolved      Boolean   @default(false)
  solvedAt      DateTime?
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemSlug])
  @@index([userId])
  @@index([problemSlug])
  @@index([isSolved])
}

model ResourceBookmark {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource PremiumResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
}

model UserActivityLog {
  id           String   @id @default(cuid())
  userId       String
  activityType String   // SIGN_IN, SIGN_OUT, REGISTER, ROADMAP_ENROLL, ROADMAP_PROGRESS, ROADMAP_COMPLETE, DSA_SOLVED, TUTORIAL_START, TUTORIAL_COMPLETE, BOOKMARK_ADD, BOOKMARK_REMOVE, PROFILE_UPDATE
  entityType   String?  // ROADMAP, DSA, TUTORIAL, RESOURCE, PROFILE, SESSION
  entityId     String?  // slug or identifier
  title        String?  // human readable activity summary
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityType])
  @@index([entityType])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model PlatformAnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  visitorId  String?  // privacy-conscious anonymous visitor session token
  eventType  String   // PAGE_VIEW, DETAIL_VIEW, ENROLL, COMPLETE, CLICK, SEARCH, BOOKMARK, SOLVE
  entityType String   // ROADMAP, TUTORIAL, DSA, RESOURCE, FEATURE, PAGE
  entityId   String   // slug or identifier
  metadata   Json?
  ipAddress  String?  // anonymized / masked
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([visitorId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([eventType, entityType, entityId])
}

model EntityInteractionCounter {
  id                  String   @id @default(cuid())
  entityType          String   // ROADMAP, TUTORIAL, DSA, RESOURCE
  entityId            String   // slug or ID
  totalViews          Int      @default(0)
  uniqueVisitorsCount Int      @default(0)
  authVisitorsCount   Int      @default(0)
  totalEnrollments    Int      @default(0)
  uniqueEnrolledCount Int      @default(0)
  completedCount      Int      @default(0)
  activeLearnersCount Int      @default(0)
  lastInteractionAt   DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([totalViews])
  @@index([totalEnrollments])
}

model PlatformAnnouncement {
  id          String   @id
  title       String
  description String   @db.Text
  category    String
  dateTime    DateTime
  priority    String   @default("NORMAL")
  status      String   @default("UPCOMING")
  actionLabel String?
  actionUrl   String?
  badge       String?
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([isFeatured])
}

